{
  "version": 1,
  "projects": {
    "root": ".oat/projects/shared",
    "defaultScope": "shared"
  },
  "archive": {
    "s3Uri": "s3://tkstang-open-agent-toolkit/repositories",
    "s3SyncOnComplete": true,
    "summaryExportPath": ".oat/repo/reference/project-summaries",
    "awsProfile": "tkstang-artifact-sync",
    "awsRegion": "us-east-1"
  },
  "pjm": {
    "initialized": true,
    "schemaVersion": 1
  },
  "localPaths": [
    ".oat/**/analysis",
    ".oat/**/pr",
    ".oat/**/reviews/archived",
    ".oat/ideas",
    ".oat/projects/**/pr",
    ".oat/projects/**/reviews/archived",
    ".oat/projects/archived",
    ".oat/projects/local"
  ],
  "workflow": {
    "archiveOnComplete": true,
    "postImplementSequence": {
      "preApproval": [
        "summary",
        "document",
        "pr"
      ],
      "postApproval": []
    }
  },
  "instructions": {
    "claude": {
      "shims": "none"
    }
  },
  "documentation": {
    "root": "docs",
    "tooling": "markdown",
    "index": "docs/index.md",
    "ia": {
      "preset": "consumer-maintainer",
      "decision": ".oat/repo/reference/decisions/DR-261025-documentation-information.md",
      "tracks": [
        {
          "path": "docs/user-guide",
          "principle": "Consumer and operator tasks: install, configure, publish, deploy, recover"
        },
        {
          "path": "docs/engineering",
          "principle": "Maintainer architecture, development, verification, and releases"
        }
      ],
      "verification": "none"
    }
  }
}
